    private void promptSaveRequestToCollection(Integer defaultColId, Integer defaultFolderId) {
        updateRequestFromUI();
        int wsId = getActiveWorkspaceId();
        
        TextInputDialog nameDialog = new TextInputDialog("My Request");
        nameDialog.setTitle("Save Request");
        nameDialog.setHeaderText("Save current request to your workspace");
        nameDialog.setContentText("Enter request display name:");
        
        nameDialog.showAndWait().ifPresent(requestName -> {
            if (defaultColId == null && defaultFolderId == null) {
                List<com.apiforge.studio.model.Collection> cols = databaseService.getCollections(wsId);
                if (cols.isEmpty()) {
                    int colId = databaseService.createCollection(wsId, "Default Collection");
                    databaseService.saveRequest(wsId, colId, null, requestName, currentRequest);
                } else {
                    ChoiceDialog<com.apiforge.studio.model.Collection> colChoice = new ChoiceDialog<>(cols.get(0), cols);
                    colChoice.setTitle("Select Collection");
                    colChoice.setHeaderText("Choose destination Collection");
                    colChoice.setContentText("Collection:");
                    
                    colChoice.showAndWait().ifPresent(chosenCol -> {
                        databaseService.saveRequest(wsId, chosenCol.getId(), null, requestName, currentRequest);
                    });
                }
            } else {
                databaseService.saveRequest(wsId, defaultColId, defaultFolderId, requestName, currentRequest);
            }
            refreshCollectionsTree();
        });
    }

